{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomodoro Vibe",
  "version": "0.1.0",
  "identifier": "com.pomodorovibe.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Pomodoro Vibe", "width": 1240, "height": 800, "minWidth": 900, "minHeight": 620, "backgroundColor": "#dce8df", "titleBarStyle": "Transparent" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon-dock.icns", "icons/icon.ico"]
  }
}
